# Exa AI search
EXA_API_KEY=your_exa_api_key_here

# Server
LOG_LEVEL=info
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8080

# Redis (cache + BullMQ)
REDIS_URL=redis://localhost:6379

# PostgreSQL (optional caching/history)
DATABASE_URL=postgresql://induss:induss@localhost:5432/induss_research

# Cache
CACHE_TTL_SECONDS=3600

# Rate limiting
EXA_MAX_CONCURRENCY=5
EXA_REQUESTS_PER_MINUTE=60

# OAuth 2.1 (GitHub) — only needed for the httpStream transport in production
# (e.g. Railway + Claude.ai connectors). Leave unset for local stdio dev.
# Create a GitHub OAuth App at github.com/settings/developers with:
#   Authorization callback URL: <MCP_BASE_URL>/oauth/callback
GITHUB_CLIENT_ID=Ov23liQdvu3r2KIeZkdt
GITHUB_CLIENT_SECRET=d527e2d721a86d96781fa557213004d3340c8875
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_ENCRYPTION_KEY=b9faefd1ac4db121b2ea705a551a45d53e469d8234b8cc831eaced8aec2e969f
OAUTH_JWT_SIGNING_KEY=98c80c425b73abd97211ee93ca170514935c94041e5431018950dff9520c5722
MCP_BASE_URL=https://your-deployment.up.railway.app
